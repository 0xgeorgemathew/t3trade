    overflow: hidden;
  }

  /* Scaling by aspect rather than a fixed height. A fixed height letterboxed
     the viewBox at narrow widths and left a band of dead space above the
     candles. */
  .chart-svg {
    width: 100%;
    height: auto;
    aspect-ratio: 900 / 500;
    display: block;
  }

  .zone { opacity: 1; }
  .zone--risk { fill: color-mix(in srgb, var(--loss) 6%, transparent); }

  /* ── Risk and reward, to scale ────────────────────────────── */
  .rr {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 10px;
    padding-top: 11px;
    border-top: 1px solid var(--border);
  }

  .rr-bar {
    display: flex;
    flex: 1;
    height: 26px;
    border-radius: 6px;
    overflow: hidden;
  }

  .rr-seg {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 0 9px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-variant-numeric: tabular-nums;
    min-width: 0;
    /* Each side is revealed by a wipe rather than a scale, so the figures
       stay at their true size while the bar measures itself out. */
    clip-path: inset(0);
  }

  .rr-cap {
    letter-spacing: 0.09em;
    text-transform: uppercase;
    font-size: 9px;
    opacity: 0.62;
  }

  .rr-val {
    margin-left: auto;
  }

  /* Both sides read outward from the entry, so the risk figure hugs the
     divider and the reward figure runs away from it. */
  .rr-seg--risk {
    background: color-mix(in srgb, var(--loss) 26%, transparent);
    color: color-mix(in srgb, var(--loss) 78%, white);
    flex-direction: row-reverse;
    border-right: 1px solid color-mix(in srgb, white 45%, transparent);
  }

  .rr-seg--risk .rr-val { margin-left: 0; margin-right: auto; }

  .rr-seg--reward {
    background: color-mix(in srgb, var(--accent) 24%, transparent);
    color: color-mix(in srgb, var(--accent) 82%, white);
  }

  .rr-note {
    display: flex;
    align-items: flex-start;
    gap: 7px;
    font-size: 12px;
    color: var(--fg-dim);
    max-width: 30ch;
    line-height: 1.4;
  }

  .rr-note strong {
    color: var(--fg);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  /* ── Success marks ────────────────────────────────────────── */
  /* One glyph for every state that came out right. It rests drawn, so a
     browser without scroll timelines still shows a finished checkmark. */
  .tick {
    width: 12px;
    height: 12px;
    flex: none;
    overflow: visible;
  }

  .tick path {
    fill: none;
    stroke: var(--ok);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .tick--lg {
    width: 19px;
    height: 19px;
  }

  .tick--lg path { stroke-width: 2.1; }

  .rr-note .tick { margin-top: 2px; }

  .candle-body { fill: currentColor; }
  .candle-wick { stroke: currentColor; stroke-width: 1.1; }
  .candle--up { color: var(--ok); }
  .candle--down { color: var(--loss); }

  .level line {
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }

  .level text {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.02em;
    fill: currentColor;
    /* The labels cross candles, so each one carries its own dark halo. */
    stroke: #0a0a0c;
    stroke-width: 3.5;
    paint-order: stroke fill;
  }

  .level--entry { color: var(--fg-muted); }
  .level--entry line { stroke: var(--fg-faint); stroke-dasharray: none; }
  .level--stop { color: var(--loss); }
  .level--stop line { stroke: var(--loss); }
  .level--target { color: var(--accent); }
  .level--target line { stroke: var(--accent); }
  .level--trigger { color: var(--warn); }
  .level--trigger line { stroke: var(--warn); }
  .level--wake { color: var(--warn); }
  .level--wake line { stroke: var(--warn); opacity: 0.55; }

  .chart-run {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.25;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .fire-dot { fill: var(--warn); }
  .fire-ping { fill: none; stroke: var(--warn); stroke-width: 1.5; opacity: 0; }
  .mark-dot { fill: var(--accent); stroke: var(--bg); stroke-width: 2; }

  /* ── Position readout ─────────────────────────────────────── */
  .console-readout {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .readout-head {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding: 3px 8px;
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .tag--market {
    color: var(--ok);
    border-color: color-mix(in srgb, var(--ok) 40%, transparent);
  }

  .readout-pnl {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 19px;
    font-variant-numeric: tabular-nums;
    color: var(--ok);
    letter-spacing: -0.01em;
  }

  .pnl-window {
    display: block;
    height: 1.3em;
    overflow: hidden;
  }

  /* Rests on the final figure so a browser without scroll timelines shows the
     number rather than a zero it will never count up from. */
  .pnl-reel {
    display: block;
    transform: translateY(calc(-16 * 1.3em));
  }

  .pnl-reel span {
    display: block;
    height: 1.3em;
    line-height: 1.3em;
    text-align: right;
  }

  .readout-progress {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .progress-track {
    flex: 1;
    height: 3px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.07);
    overflow: hidden;
  }

  .progress-fill {
    display: block;
    height: 100%;
    width: 22.4%;
    border-radius: 999px;
    background: var(--accent);
    transform-origin: 0 50%;
  }

  .progress-label {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--fg-dim);
    white-space: nowrap;
  }

  .readout-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .readout-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 11px;
    background: rgba(9, 9, 11, 0.9);
  }

  .readout-row dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .readout-row dd {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-variant-numeric: tabular-nums;
    color: var(--fg);
  }

  .readout-legend {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .readout-armed {
    display: flex;
    flex-direction: column;
    gap: 7px;
    margin-top: auto;
  }

  .armed-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-top: 7px;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
  }

  .armed-label {
    flex: 1;
    color: var(--fg-muted);
    line-height: 1.35;
  }

  .armed-state {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-faint);
    flex-shrink: 0;
  }

  .armed-row--met .armed-state { color: var(--ok); }

  /* ── The run came out clean ───────────────────────────────── */
  .console-success {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 12px;
    padding: 13px 16px;
    border: 1px solid color-mix(in srgb, var(--ok) 34%, transparent);
    border-radius: var(--radius-sm);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--ok) 11%, transparent), transparent 62%),
      rgba(9, 9, 11, 0.9);
  }

  .success-head {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--ok) 55%, white);
    flex: none;
  }

  .success-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    font-variant-numeric: tabular-nums;
    color: var(--fg-dim);
  }

  /* ── Beat rail ────────────────────────────────────────────── */
  .beat-rail {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 1px;
    margin-top: 12px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .beat {
    padding: 11px 13px 12px;
    background: rgba(9, 9, 11, 0.9);
    border-top: 2px solid transparent;
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .beat-head {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .beat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .beat-tick {
    width: 11px;
    height: 11px;
    margin-left: auto;
  }

  .beat-note {
    font-size: 12px;
    line-height: 1.4;
    color: var(--fg-faint);
  }

  /* ── Mission notes ────────────────────────────────────────── */
  /* One rule across the top and a divider between each note, so the three
     read as one group closing out the console rather than three columns
     floating below it. */
  .mission-notes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0;
    padding-top: 0;
    padding-bottom: 92px;
    margin-top: 0;
    border-top: 1px solid var(--border);
  }

  .note {
    padding: 22px 30px 0 0;
  }

  .note + .note {
    padding-left: 30px;
    border-left: 1px solid var(--border);
  }

  .note h3 {
    font-size: 15.5px;
    font-weight: 500;
    letter-spacing: -0.015em;
    margin-bottom: 7px;
  }

  .note p {
    color: var(--fg-muted);
    font-size: 14.5px;
    line-height: 1.6;
  }

  /* ── Checks ───────────────────────────────────────────────── */
  /* Not pinned. The console above already holds the reader still for three
     viewports, and a second pinned box left a screen of empty space between
     the two. This one scrubs as it enters, at normal section height. */
  .sec-checks {
    padding: 0;
    background: #08080a;
  }

  .checks-scroller {
    min-height: 0;
  }

  .checks-sticky {
    padding: 104px 0;
  }

  .checks-inner {
    display: grid;
    grid-template-columns: 1fr 1.02fr;
    gap: 64px;
    align-items: center;
  }

  .rail-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin-top: 28px;
  }

  .rail-list li {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.55;
    padding-left: 18px;
    border-left: 2px solid color-mix(in srgb, var(--accent) 35%, transparent);
  }

  .rail-list strong {
    color: var(--fg);
    font-weight: 500;
  }

  .preview-card {
    padding: 20px;
    background: rgba(9, 9, 11, 0.7);
  }

  .preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 14px;
  }

  .preview-title {
    font-family: var(--font-mono);
    font-size: 13px;
  }

  /* Odometer: a reel of digits translated by the same scroll timeline that
     ticks the checks, snapped to whole numbers. */
  .preview-tally {
    display: inline-flex;
    align-items: baseline;
    gap: 4px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent);
  }

  .tally-window {
    display: block;
    height: 1.25em;
    overflow: hidden;
  }

  /* Rests on 17 so a browser without scroll timelines shows the passing count
     rather than a zero it will never count up from. */
  .tally-reel {
    display: block;
    transform: translateY(calc(-17 * 1.25em));
  }

  .tally-reel span {
    display: block;
    height: 1.25em;
    line-height: 1.25em;
    font-variant-numeric: tabular-nums;
    text-align: right;
    min-width: 2ch;
  }

  .tally-total {
    color: var(--fg-dim);
    font-size: 11px;
  }

  .preview-list {
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .preview-list li {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 0;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
  }

  .preview-list li svg {
    color: var(--ok);
    flex-shrink: 0;
  }

  .preview-check-label {
    color: var(--fg-muted);
    flex: 1;
  }

  .preview-check-detail {
    color: var(--fg-faint);
    font-size: 11px;
  }

  .preview-verdict {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
  }

  .preview-stamp {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
    padding: 4px 10px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, transparent);
    border-radius: 999px;
  }

  .preview-verdict-note {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
  }

  .controls-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
  }

  .controls-strip-label {
    font-size: 12px;
    color: var(--fg-dim);
    margin-right: 4px;
  }

  .control-chip {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-muted);
    padding: 4px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
  }

  /* ── Harnesses ────────────────────────────────────────────── */
  .harness-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 48px;
  }

  .harness {
    padding: 20px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    border-right: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.02), transparent);
    transition: background 0.2s ease;
  }

  .harness:last-child { border-right: 0; }
  .harness:hover { background: rgba(255, 255, 255, 0.035); }

  .harness-top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .harness-mark {
    flex-shrink: 0;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
  }

  .harness-mark img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .harness-name {
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  /* The command you already run to authenticate it. */
  .harness-cmd {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--fg-muted);
    padding: 6px 9px;
    border-radius: var(--radius-sm);
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid var(--border);
    overflow-x: auto;
    white-space: nowrap;
  }

  .harness-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-top: auto;
  }

  .harness-tag--trades { color: var(--ok); }

  /* ── Signer key ───────────────────────────────────────────── */
  .arming-inner {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: center;
  }

  .arming-card {
    padding: 26px 24px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .arming-row {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .arming-state {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .arming-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .arming-state--safe { color: var(--fg-muted); }
  .arming-state--safe .arming-dot { background: var(--fg-dim); }
  .arming-state--armed { color: var(--ok); }

  .arming-state--armed .arming-dot {
    background: var(--ok);
    animation: pulse 2s ease-in-out infinite;
  }

  .arming-desc {
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.5;
  }

  .arming-divider {
    height: 1px;
    background: var(--border);
  }

  /* ── Scope ────────────────────────────────────────────────── */
  .state-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 48px;
  }

  .state-card { padding: 26px 24px; }

  .state-card-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-bottom: 16px;
  }

  .state-card-label--is { color: var(--ok); }
  .state-card-label--isnt { color: var(--warn); }

  .state-card ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .state-card li {
    color: var(--fg-muted);
    font-size: 15px;
    line-height: 1.5;
    padding-left: 16px;
    position: relative;
  }

  .state-card li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.66em;
    width: 6px;
    height: 1px;
    background: var(--fg-faint);
  }

  /* ── Open source ──────────────────────────────────────────── */
  .open-inner {
    max-width: 760px;
  }

  .open-eyebrow {
    color: var(--accent);
    margin-bottom: 16px;
  }

  .open-title {
    max-width: 20ch;
  }

  .open-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  /* ── Final CTA ────────────────────────────────────────────── */
  .sec-cta {
    text-align: center;
    padding: 130px 0;
    position: relative;
    overflow: hidden;
  }

  .sec-cta::before {
    content: "";
    position: absolute;
    inset: auto 0 -50% 0;
    height: 60%;
    background: radial-gradient(ellipse at center, var(--accent-dim) 0%, transparent 60%);
    pointer-events: none;
    opacity: 0.6;
  }

  .cta-inner { position: relative; }

  .cta-title {
    font-size: clamp(38px, 5.6vw, 66px);
  }

  .cta-sub {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 520px;
    margin: 20px auto 34px;
    line-height: 1.55;
    letter-spacing: -0.005em;
  }

  .cta-actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .cta-release {
    margin-top: 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-dim);
    letter-spacing: 0.02em;
  }

  .cta-release span { color: var(--fg-muted); }

  .cta-install-label {
    margin: 26px 0 8px;
    color: var(--fg-dim);
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  /* The command has to survive a phone without wrapping into nonsense, so it
     scrolls inside its own box rather than breaking mid-URL. */
  .cta-install {
    margin: 0 auto;
    max-width: 640px;
    overflow-x: auto;
    padding: 10px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: rgba(0, 0, 0, 0.25);
    text-align: left;
  }

  .cta-install code {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-muted);
    white-space: pre;
  }

  .cta-install--sm {
    margin-top: 14px;
    max-width: 560px;
  }

  .cta-note {
    margin: 26px auto 0;
    max-width: 560px;
    color: var(--fg-dim);
    font-size: 13px;
    line-height: 1.6;
  }

  .cta-note a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: rgba(161, 161, 170, 0.4);
    text-underline-offset: 3px;
  }

  .cta-note a:hover {
    color: var(--fg);
    text-decoration-color: var(--fg);
  }

  /* ── Scroll-driven layer ──────────────────────────────────────
     Everything below is scrubbed by the wheel or the finger. Without support
     the page renders at each animation's resting state, which is the final
     frame, so nothing is hidden from anyone. */
  @media (prefers-reduced-motion: no-preference) {
