---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL, UPSTREAM_REPOSITORY_URL } from "../lib/site";

/* Headlines resolve one word at a time as the section scrolls past, so each
   word needs its own slice of the shared view timeline. */
function kineticWords(sentence: string) {
  return sentence.split(" ").map((word, index) => ({
    word,
    range: `entry ${10 + index * 3}% cover ${36 + index * 3}%`,
  }));
}

/* The lifecycle chart is generated at build time from a fixed seed so every
   deploy renders the identical shape: a range, a break, then a run. No prices
   are printed on it. It shows the structure of a mission, not a real trade. */
const CANDLE_COUNT = 34;

function tradeSeries() {
  let seed = 20260814;
  const rand = () => {
    seed = (seed * 1103515245 + 12345) % 2147483648;
    return seed / 2147483648;
  };

  const candles: { open: number; close: number; high: number; low: number; up: boolean }[] = [];
  let price = 42;

  for (let index = 0; index < CANDLE_COUNT; index += 1) {
    const phase = index / CANDLE_COUNT;
    const drift = phase < 0.5 ? (rand() - 0.5) * 3.2 : phase < 0.62 ? 3.4 : 1.6;
    const open = price;
    const close = Math.max(8, Math.min(88, open + drift + (rand() - 0.5) * 2.4));
    const high = Math.max(open, close) + rand() * 2.6;
    const low = Math.min(open, close) - rand() * 2.6;
    price = close;
    candles.push({ open, close, high, low, up: close >= open });
  }

  return candles;
}

/* Rescale the walk into the middle 66% of the chart so the levels above and
   below it have room to sit. */
const rawCandles = tradeSeries();
const seriesLow = Math.min(...rawCandles.map((candle) => candle.low));
const seriesHigh = Math.max(...rawCandles.map((candle) => candle.high));
const fit = (value: number) => 17 + ((value - seriesLow) / (seriesHigh - seriesLow)) * 66;

const candles = rawCandles.map((candle) => ({
  open: fit(candle.open),
  close: fit(candle.close),
  high: fit(candle.high),
  low: fit(candle.low),
  up: candle.up,
}));

const CHART_W = 660;
const CHART_H = 280;
const SLOT = CHART_W / CANDLE_COUNT;
const yOf = (value: number) => CHART_H - (value / 100) * CHART_H;

const BREAK_INDEX = 17;
const entry = candles[BREAK_INDEX].close;
const stop = Math.min(...candles.slice(0, BREAK_INDEX).map((candle) => candle.low)) - 3;
const target = candles[CANDLE_COUNT - 1].close + 7;

const runPath = candles
  .slice(BREAK_INDEX)
  .map((candle, index) => {
    const x = (BREAK_INDEX + index) * SLOT + SLOT / 2;
    return `${index === 0 ? "M" : "L"}${x.toFixed(1)} ${yOf(candle.close).toFixed(1)}`;
  })
  .join(" ");

/* Six of the seventeen, named the way the preview tool names them. */
const previewChecks = [
  { label: "mission active, entries allowed", detail: "authority current" },
  { label: "market, side, and leverage allowed", detail: "within mandate" },
  { label: "account and order book fresh", detail: "live exchange data" },
  { label: "size, price, and minimum valid", detail: "exchange rules" },
  { label: "position and mission risk available", detail: "usd loss budget" },
  { label: "reduce-only stop attached", detail: "required" },
];

const controls = ["Pause", "Cancel entries", "Reduce 50%", "Close", "Revoke"];

/* Rendered as placeholders and filled in from the Hyperliquid testnet API on
   the client. If that call fails the band removes itself rather than show a
   number nobody can verify. */
const tapeMarkets = ["BTC", "ETH", "SOL", "HYPE", "AVAX", "LINK", "ARB", "DOGE"];

const harnesses = [
  { name: "Claude Code", tag: "trading missions", icon: "claude-ai-icon.svg" },
  { name: "Codex CLI", tag: "trading missions", icon: "openai_dark.svg" },
  { name: "OpenCode", tag: "trading missions", icon: "opencode-dark.svg" },
  { name: "Cursor", tag: "coding threads", icon: "cursor_light.svg" },
  { name: "Grok CLI", tag: "coding threads", icon: "grok-dark.svg" },
];
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-float" aria-hidden="true">
      <span class="hero-float-mark hf-claude"><img src="/harnesses/claude-ai-icon.svg" alt="" /></span>
      <span class="hero-float-mark hf-codex"><img src="/harnesses/openai_dark.svg" alt="" /></span>
      <span class="hero-float-mark hf-opencode"><img src="/harnesses/opencode-dark.svg" alt="" /></span>
      <span class="hero-float-mark hf-cursor"><img src="/harnesses/cursor_light.svg" alt="" /></span>
      <span class="hero-float-mark hf-grok"><img src="/harnesses/grok-dark.svg" alt="" /></span>
    </div>

    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Open source · alpha · Hyperliquid testnet</p>

      <h1 class="hero-title display">
        The trading interface<br />for coding agents.
      </h1>

      <p class="hero-sub">
        Give an agent a mandate in plain English. T3 Trade holds it to hard limits and signs
        every order locally.
      </p>

      <div class="hero-actions">
        <a id="download-btn" href="https://github.com/0xgeorgemathew/t3trade/releases" class="btn btn-primary btn-lg">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <span>Download for macOS</span>
        </a>
        <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          <span>Run from source</span>
          <svg class="hero-source-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </div>

      <div class="hero-preview">
        <figure class="hero-screenshot-frame">
          <img
            src="/t3trade-screenshot.webp"
            alt="T3 Trade showing an ETH mission: the agent's reasoning, its fills, an open position with entry, stop and target, and three armed market watches"
            width="2400"
            height="1535"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </figure>
        <figcaption class="hero-preview-caption">
          One ETH mission in the desktop app: the agent's reasoning, its fills, the open
          position with its stop and target, and the watches that will wake it.
        </figcaption>
      </div>
    </div>
  </section>

  <!-- ── Live testnet band ─────────────────────────────────────── -->
  <section class="sec-tape" aria-label="Hyperliquid testnet markets">
    <div class="tape" id="tape" data-state="loading">
      <div class="tape-track">
        {[0, 1].map((copy) => (
          <div class="tape-run" aria-hidden={copy === 1 ? "true" : undefined}>
            {tapeMarkets.map((symbol) => (
              <span class="tape-item" data-symbol={symbol} data-copy={copy}>
                <span class="tape-sym">{symbol}</span>
                <span class="tape-px">- - - -</span>
                <span class="tape-chg">·</span>
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>

    <div class="container tape-note">
      <p>
        Live mid prices from Hyperliquid testnet, the only network this alpha talks to.
        Testnet funds have no real-world value and there is no mainnet configuration.
      </p>
    </div>
  </section>

  <!-- ── Mission lifecycle ─────────────────────────────────────── -->
  <section id="missions" class="sec-mission">
    <div class="container mission-inner">
      <figure class="mission-chart" aria-hidden="true">
        <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="none" class="chart-svg">
          <line class="chart-level chart-level--target" x1="0" x2={CHART_W} y1={yOf(target)} y2={yOf(target)} />
          <line class="chart-level chart-level--entry" x1="0" x2={CHART_W} y1={yOf(entry)} y2={yOf(entry)} />
          <line class="chart-level chart-level--stop" x1="0" x2={CHART_W} y1={yOf(stop)} y2={yOf(stop)} />

          {candles.map((candle, index) => {
            const x = index * SLOT + SLOT / 2;
            const top = yOf(Math.max(candle.open, candle.close));
            const bottom = yOf(Math.min(candle.open, candle.close));
            const start = 16 + index * 1.1;
            return (
              <g
                class={`candle ${candle.up ? "candle--up" : "candle--down"}`}
                style={`animation-range: entry ${start.toFixed(1)}% cover ${(start + 22).toFixed(1)}%; transform-origin: ${x.toFixed(1)}px ${CHART_H}px`}
              >
                <line class="candle-wick" x1={x} x2={x} y1={yOf(candle.high)} y2={yOf(candle.low)} />
                <rect
                  class="candle-body"
                  x={x - SLOT * 0.3}
                  width={SLOT * 0.6}
                  y={top}
                  height={Math.max(1.5, bottom - top)}
                />
              </g>
            );
          })}

          <path class="chart-run" d={runPath} pathLength="1" />
        </svg>

        <figcaption class="chart-legend">
          <span class="chart-key chart-key--target">target</span>
          <span class="chart-key chart-key--entry">entry</span>
          <span class="chart-key chart-key--stop">stop</span>
        </figcaption>
      </figure>

      <div class="mission-copy">
        <h2 class="section-title kinetic">
          {kineticWords("One thread. One market. One mandate.").map(({ word, range }) => (
            <>
              <span style={`animation-range: ${range}`}>{word}</span>{" "}
            </>
          ))}
        </h2>
        <p class="section-lede scrub">
          A mission is a trading thread. Pick a perp market, type your mandate as the first
          message, and T3 Trade binds that conversation to one testnet account with a fixed
          direction, leverage ceiling, notional cap, and loss budget in USD.
        </p>

        <ol class="mission-steps">
          <li class="mission-step scrub">
            <h3>It sleeps until the market moves</h3>
            <p>
              The agent registers a price cross, candle close, position update, or
              unrealised-PnL watch. When one fires, the same thread resumes with fresh
              account, position, order, and budget data.
            </p>
          </li>
          <li class="mission-step scrub">
            <h3>The exchange is the source of truth</h3>
            <p>
              Positions, orders, and fills are re-read from Hyperliquid after every
              submission, fill, reconnect, and restart. Local records never override it.
            </p>
          </li>
          <li class="mission-step scrub">
            <h3>Risk is counted before entry, not after</h3>
            <p>
              Realised loss, paid fees, protected open risk, and pending-entry risk all draw
              down the same budget. Exhaust it and new exposure is blocked while existing
              stops stay in place.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ── The seventeen checks ──────────────────────────────────── -->
  <section id="rails" class="sec-checks">
    <div class="checks-scroller">
      <div class="checks-sticky">
        <div class="container checks-inner">
          <div class="checks-copy">
            <h2 class="section-title">Every entry passes the same seventeen checks.</h2>
            <p class="section-lede">
              Before signing a position-increasing order, T3 Trade re-checks mission status,
              authority, agent lease, direction, signer approval, data freshness, size, price,
              exchange minimums, leverage, notional, per-position risk, the loss budget,
              pending conflicts, and the stop. One failure rejects the order.
            </p>
            <ul class="rail-list">
              <li><strong>Every position increase carries a stop.</strong> T3 Trade submits an exchange-native reduce-only stop, then reconciles its size against the position Hyperliquid reports.</li>
              <li><strong>A retry is the same order.</strong> The client order ID and local request key are deterministic, so a resubmission cannot open a second position.</li>
              <li><strong>You keep the controls.</strong> Pause, cancel entries, reduce, close, and revoke all work with the agent CLI stopped.</li>
            </ul>
          </div>

          <div class="checks-visual">
            <div class="tile preview-card">
              <div class="preview-head">
                <span class="preview-title">trading_preview_order</span>
                <span class="preview-tally" aria-label="17 checks passing">
                  <span class="tally-window">
                    <span class="tally-reel">
                      {Array.from({ length: 18 }, (_, n) => <span>{n}</span>)}
                    </span>
                  </span>
                  <span class="tally-total">/ 17</span>
                </span>
              </div>

              <ul class="preview-list">
                {previewChecks.map((check, index) => (
                  <li style={`animation-range: contain ${6 + index * 9}% contain ${20 + index * 9}%`}>
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                    <span class="preview-check-label">{check.label}</span>
                    <span class="preview-check-detail">{check.detail}</span>
                  </li>
                ))}
              </ul>

              <div class="preview-verdict">
                <span class="preview-stamp">signed locally</span>
                <span class="preview-verdict-note">all seventeen passed</span>
              </div>
            </div>

            <div class="controls-strip">
              <span class="controls-strip-label">Operator controls</span>
              {controls.map((control, index) => (
                <span class="control-chip" style={`animation-range: contain ${58 + index * 6}% contain ${70 + index * 6}%`}>{control}</span>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Harnesses ─────────────────────────────────────────────── -->
  <section id="harnesses" class="sec-harness">
    <div class="container">
      <h2 class="section-title kinetic">
        {kineticWords("Bring your own agent CLI.").map(({ word, range }) => (
          <>
            <span style={`animation-range: ${range}`}>{word}</span>{" "}
          </>
        ))}
      </h2>
      <p class="section-lede scrub">
        T3 Trade drives five CLIs already installed and authenticated on your machine. Three of
        them can run trading missions today. None of them ever receives the signer key.
      </p>

      <div class="harness-grid">
        {harnesses.map((harness, index) => (
          <div class="harness scrub" style={`animation-range: entry ${4 + index * 5}% cover ${26 + index * 5}%`}>
            <div class="harness-mark"><img src={`/harnesses/${harness.icon}`} alt="" /></div>
            <div class="harness-meta">
              <div class="harness-name">{harness.name}</div>
              <div class="harness-tag">{harness.tag}</div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Signer key ────────────────────────────────────────────── -->
  <section id="arming" class="sec-arming">
    <div class="container arming-inner">
      <div class="tile arming-card scrub">
        <div class="arming-row">
          <span class="arming-state arming-state--safe">
            <span class="arming-dot"></span> No valid signer key
          </span>
          <span class="arming-desc">
            Execution is disabled. Every action that needs a signature is rejected.
          </span>
        </div>
        <div class="arming-divider" aria-hidden="true"></div>
        <div class="arming-row">
          <span class="arming-state arming-state--armed">
            <span class="arming-dot"></span> Valid key loaded
          </span>
          <span class="arming-desc">
            Execution is enabled for the Hyperliquid testnet account derived from that key.
          </span>
        </div>
      </div>

      <div class="arming-copy">
        <h2 class="section-title">Execution needs one local testnet key.</h2>
        <p class="section-lede">
          This alpha has no wallet onboarding. Put a single 32-byte EVM private key for a
          Hyperliquid testnet account in <code>~/.t3trade/secrets</code>. T3 Trade derives the
          address, holds the raw key in server memory, and signs orders locally with it. The
          key is never written to logs, reports, or the database. Use a testnet-only key.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Scope ─────────────────────────────────────────────────── -->
  <section id="state" class="sec-state">
    <div class="container">
      <h2 class="section-title">What ships in this alpha.</h2>
      <div class="state-grid">
        <div class="tile state-card scrub">
          <div class="state-card-label state-card-label--is">Today</div>
          <ul>
            <li>Trading missions on Claude Code, Codex, and OpenCode</li>
            <li>Hyperliquid testnet orders under fixed authority and a USD loss limit</li>
            <li>Required reduce-only stops, exchange reconciliation, retry-safe submission</li>
            <li>An Apple Silicon macOS app and a self-hosted web app run from source</li>
          </ul>
        </div>
        <div class="tile state-card scrub" style="animation-range: entry 14% cover 38%">
          <div class="state-card-label state-card-label--isnt">Not today</div>
          <ul>
            <li>No mainnet support of any kind</li>
            <li>No packaged Windows, Linux, or Intel Mac builds</li>
            <li>No wallet onboarding, only the local testnet key</li>
            <li>No mobile app and no unattended trading with real funds</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Open source ───────────────────────────────────────────── -->
  <section id="open" class="sec-open">
    <div class="container open-inner">
      <p class="eyebrow open-eyebrow">Open source</p>
      <h2 class="section-title kinetic open-title">
        {kineticWords("Built on T3 Code. Open all the way down.").map(({ word, range }) => (
          <>
            <span style={`animation-range: ${range}`}>{word}</span>{" "}
          </>
        ))}
      </h2>
      <p class="section-lede scrub">
        T3 Trade is an MIT-licensed fork of <a class="inline-link" href={UPSTREAM_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">T3 Code</a>,
        Ping Labs' open-source interface for coding agents. It keeps the upstream agent and
        repository workflows, adds trading in dedicated packages, and records every intentional
        fork change in <code>PATCH_LEDGER.md</code>.
      </p>
      <div class="open-actions scrub">
        <a class="btn btn-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Browse the source</a>
        <a class="btn btn-ghost" href={`${GITHUB_REPOSITORY_URL}/blob/main/docs/architecture/trading-execution.md`} target="_blank" rel="noopener noreferrer">Read the execution design</a>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────── -->
  <section id="download" class="sec-cta">
    <div class="container cta-inner">
      <h2 class="display cta-title">Run T3 Trade on testnet.</h2>
      <p class="cta-sub">
        Install a supported agent CLI, add a testnet-only signer key, pick a perp, and type your
        mandate.
      </p>
      <div class="cta-actions">
        <a id="cta-download-btn" class="btn btn-primary btn-lg" href="https://github.com/0xgeorgemathew/t3trade/releases">
          Download for macOS
        </a>
        <a class="btn btn-ghost btn-lg" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Run from source</a>
      </div>
      <p class="cta-release" id="hero-release" hidden>
        <span id="hero-release-tag"></span> · macOS arm64 · not notarized
      </p>

      <p class="cta-install-label">or install it in one line</p>
      <pre class="cta-install"><code>curl -fsSL https://raw.githubusercontent.com/0xgeorgemathew/t3trade/main/scripts/install-macos.sh | bash</code></pre>

      <p class="cta-note">
        The macOS build is Apple Silicon only and is not notarized, so a downloaded copy is
        quarantined and macOS may refuse to open it. The installer above fetches the same DMG
        and clears that flag. To do it by hand, drag the app to Applications and run:
      </p>
      <pre class="cta-install cta-install--sm"><code>xattr -dr com.apple.quarantine "/Applications/T3 Trade (Alpha).app"</code></pre>
      <p class="cta-note">
        Older builds and checksums are on the
        <a href="https://github.com/0xgeorgemathew/t3trade/releases" target="_blank" rel="noopener noreferrer">releases page</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL } from "../lib/releases";

  async function initDownload() {
    const heroBtn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const ctaBtn = document.getElementById("cta-download-btn") as HTMLAnchorElement | null;
    const releaseLine = document.getElementById("hero-release");
    const releaseTag = document.getElementById("hero-release-tag");

    try {
      const release = await fetchLatestRelease();
      const dmg = (release?.assets ?? []).find((a) => a.name.endsWith("-arm64.dmg"));
      if (!dmg) throw new Error("no arm64 dmg in latest release");

      if (heroBtn) heroBtn.href = dmg.browser_download_url;
      if (ctaBtn) ctaBtn.href = dmg.browser_download_url;
      if (releaseLine && releaseTag && release?.tag_name) {
        releaseTag.textContent = release.tag_name;
        releaseLine.hidden = false;
      }
    } catch {
      if (heroBtn) heroBtn.href = RELEASES_URL;
      if (ctaBtn) ctaBtn.href = RELEASES_URL;
    }
  }

  /* Real mids from the same testnet the app trades on. The band starts in a
     shimmering placeholder state and removes itself if the call fails, so it
     never shows a price that did not come from the exchange. */
  const TESTNET_INFO_URL = "https://api.hyperliquid-testnet.xyz/info";

  type AssetCtx = { midPx: string | null; prevDayPx: string | null };
  type MetaAndCtxs = [{ universe: { name: string }[] }, AssetCtx[]];

  function formatPrice(value: number) {
    const decimals = value >= 1000 ? 1 : value >= 1 ? 3 : 5;
    return value.toLocaleString("en-US", {
      minimumFractionDigits: decimals,
      maximumFractionDigits: decimals,
    });
  }

  async function initTape() {
    const tape = document.getElementById("tape");
    if (!tape) return;

    try {
      const response = await fetch(TESTNET_INFO_URL, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ type: "metaAndAssetCtxs" }),
      });
      if (!response.ok) throw new Error(`hyperliquid info ${response.status}`);

      const [meta, contexts] = (await response.json()) as MetaAndCtxs;
      const bySymbol = new Map<string, AssetCtx>();
      meta.universe.forEach((asset, index) => {
        const context = contexts[index];
        if (context) bySymbol.set(asset.name, context);
      });

      let filled = 0;
      for (const item of tape.querySelectorAll<HTMLElement>(".tape-item")) {
        const context = bySymbol.get(item.dataset.symbol ?? "");
        const mid = Number(context?.midPx);
        const prev = Number(context?.prevDayPx);
        if (!Number.isFinite(mid) || mid <= 0) {
          item.remove();
          continue;
        }

        const priceEl = item.querySelector(".tape-px");
        const changeEl = item.querySelector(".tape-chg");
        if (priceEl) priceEl.textContent = formatPrice(mid);

        if (changeEl && Number.isFinite(prev) && prev > 0) {
          const change = ((mid - prev) / prev) * 100;
          changeEl.textContent = `${change >= 0 ? "+" : ""}${change.toFixed(2)}%`;
          changeEl.classList.add(change >= 0 ? "is-up" : "is-down");
        } else if (changeEl) {
          changeEl.remove();
        }
        filled += 1;
      }

      tape.dataset.state = filled > 0 ? "live" : "empty";
      if (filled === 0) tape.closest("section")?.remove();
    } catch {
      tape.dataset.state = "empty";
      tape.closest("section")?.remove();
    }
  }

  /* One pointer listener for the whole grid of tiles. It writes two custom
     properties and nothing else, so hover lighting costs no layout work. */
  function initTileSpotlight() {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(hover: none)").matches) return;

    for (const tile of document.querySelectorAll<HTMLElement>(".tile")) {
      tile.addEventListener(
        "pointermove",
        (event) => {
          const box = tile.getBoundingClientRect();
          tile.style.setProperty("--mx", `${event.clientX - box.left}px`);
          tile.style.setProperty("--my", `${event.clientY - box.top}px`);
        },
        { passive: true },
      );
    }
  }

  initDownload();
  initTape();
  initTileSpotlight();
</script>

