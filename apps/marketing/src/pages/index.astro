---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL, UPSTREAM_REPOSITORY_URL } from "../lib/site";

const previewChecks = [
  { label: "mission market & side", detail: "within mission" },
  { label: "leverage ≤ mission cap", detail: "20x ≤ 20x" },
  { label: "gross notional within budget", detail: "reservation ledger" },
  { label: "exchange minimums & tick size", detail: "size, price band" },
  { label: "BBO freshness & slippage bound", detail: "priced off live book" },
  { label: "stop-loss attached, reduce-only", detail: "mandatory" },
];

const controls = ["Pause", "Cancel entries", "Reduce 50%", "Close", "Revoke"];
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>

    <div class="hero-float" aria-hidden="true">
      <span class="hero-float-mark hf-claude" title="Claude Code">
        <img src="/harnesses/claude-ai-icon.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-codex" title="Codex">
        <img src="/harnesses/openai_dark.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-opencode" title="OpenCode">
        <img src="/harnesses/opencode-dark.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-cursor" title="Cursor">
        <img src="/harnesses/cursor_light.svg" alt="" />
      </span>
      <span class="hero-float-mark hf-grok" title="Grok">
        <img src="/harnesses/grok-dark.svg" alt="" />
      </span>
    </div>

    <div class="container hero-inner">
      <p class="eyebrow hero-eyebrow">Agentic Trading Environment · alpha · Hyperliquid testnet</p>

      <h1 class="hero-title display">
        Run coding agents on Hyperliquid testnet<br />with enforced risk limits.
      </h1>

      <p class="hero-sub">
        T3 Trade is an <strong>Agentic Trading Environment</strong> for Hyperliquid testnet.
        It gives coding agents typed, restricted tools to read market data, create plans,
        and propose trades. T3 Trade enforces the mission and risk limits.
      </p>

      <div class="hero-actions">
        <a id="download-btn" href="https://github.com/0xgeorgemathew/t3trade/releases" class="btn btn-primary btn-lg">
          <svg class="dl-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000" aria-hidden="true"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg>
          <span>Download for macOS</span>
        </a>
        <a class="hero-source-link" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
          <span>Run from source</span>
          <svg class="hero-source-arrow" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
        <p class="hero-release" id="hero-release" hidden>
          <span id="hero-release-tag"></span> · macOS arm64 · unsigned · right-click and
          choose Open on first launch
        </p>
        <p class="hero-caution">
          Alpha software. Places real orders on Hyperliquid <strong>testnet</strong>.
          Mainnet is not supported.
        </p>
      </div>

      <div class="hero-preview">
        <figure class="hero-screenshot-frame">
          <img
            src="/t3trade-screenshot.webp"
            alt="T3 Trade showing a BTC mission with the agent's plan, active price watches, and position details"
            width="2400"
            height="1520"
            loading="eager"
            decoding="async"
          />
        </figure>
        <figcaption class="hero-preview-caption">
          A live mission showing the agent's plan, active price watches, and position data
          from the exchange.
        </figcaption>
      </div>
    </div>
  </section>

  <!-- ── Mission anatomy ──────────────────────────────────────── -->
  <section id="missions" class="sec-missions">
    <div class="container">
      <div class="section-head">
        <h2>Each mission has defined limits.</h2>
        <p>
          A mission connects one agent thread to one market with a written strategy, a
          maximum-loss budget, and an expiry. The agent's trading tools are limited to that
          mission.
        </p>
      </div>

      <div class="mission-grid">
        <div class="tile mission-tile">
          <div class="mission-tile-label">Runs when market events occur</div>
          <p>
            The agent can register watches for a price cross, an unrealised-PnL level, or a
            candle close. When a watch fires, the agent receives current account, position,
            order, and budget data.
          </p>
        </div>
        <div class="tile mission-tile">
          <div class="mission-tile-label">Uses exchange-reported state</div>
          <p>
            T3 Trade reads positions, orders, and fills from Hyperliquid. Its database stores
            its own actions, while exchange data remains the source of truth.
          </p>
        </div>
        <div class="tile mission-tile">
          <div class="mission-tile-label">Enforces the loss budget</div>
          <p>
            Automated tests cover the loss calculations. An exhausted budget blocks new
            exposure without removing stops from open positions.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Preview checklist (signature) ────────────────────────── -->
  <section id="rails" class="sec-checklist">
    <div class="container checklist-inner">
      <div class="checklist-copy">
        <div class="section-head" style="margin-bottom:0">
          <h2>Every order must pass 17 checks.</h2>
          <p>
            Before signing, T3 Trade checks the mission, leverage, notional, exchange
            minimums, risk reservations, and the required stop-loss. Any failed check rejects
            the order.
          </p>
          <ul class="rail-list">
            <li>
              <strong>Every position requires protection.</strong> Each confirmed position
              increase must have an exchange-native reduce-only stop sized against the
              exchange-reported position.
            </li>
            <li>
              <strong>Retries do not duplicate orders.</strong> A deterministic client order ID
              and local idempotency key make retries return the existing order record.
            </li>
            <li>
              <strong>Controls work without the agent.</strong> Pause, cancel entries, reduce,
              close, and revoke still work when the agent provider is stopped.
            </li>
          </ul>
        </div>
      </div>

      <div class="checklist-visual">
        <div class="tile preview-card">
          <div class="preview-head">
            <span class="preview-title">trading_preview_order</span>
            <span class="preview-status">17 checks</span>
          </div>
          <ul class="preview-list">
            {previewChecks.map((check) => (
              <li>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                <span class="preview-check-label">{check.label}</span>
                <span class="preview-check-detail">{check.detail}</span>
              </li>
            ))}
            <li class="preview-more">Sign and submit only after all checks pass</li>
          </ul>
        </div>
        <div class="controls-strip" aria-label="Deterministic mission controls">
          <span class="controls-strip-label">Works without the agent:</span>
          {controls.map((control) => (
            <span class="control-chip">{control}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ── Harnesses ─────────────────────────────────────────────── -->
  <section id="harnesses" class="sec-harness">
    <div class="container">
      <div class="section-head">
        <h2>Supports five coding-agent CLIs.</h2>
        <p>
          T3 Trade uses coding-agent CLIs installed and authenticated on your machine. The
          agent creates and explains the plan. Only T3 Trade accesses the signer key.
        </p>
      </div>

      <div class="harness-grid">
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/claude-ai-icon.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Claude Code</div>
            <div class="harness-tag">claude auth login</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/openai_dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Codex CLI</div>
            <div class="harness-tag">codex login</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/opencode-dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">OpenCode</div>
            <div class="harness-tag">opencode auth</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/cursor_light.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Cursor</div>
            <div class="harness-tag">cursor-agent</div>
          </div>
        </div>
        <div class="harness">
          <div class="harness-mark"><img src="/harnesses/grok-dark.svg" alt="" /></div>
          <div class="harness-meta">
            <div class="harness-name">Grok CLI</div>
            <div class="harness-tag">grok login</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Arming / signer key ──────────────────────────────────── -->
  <section id="arming" class="sec-arming">
    <div class="container arming-inner">
      <div class="tile arming-card">
        <div class="arming-row">
          <span class="arming-state arming-state--safe">
            <span class="arming-dot"></span> No signer key
          </span>
          <span class="arming-desc">
            Read-only. You can use missions, watches, and plans, but orders are not signed or
            submitted.
          </span>
        </div>
        <div class="arming-divider" aria-hidden="true"></div>
        <div class="arming-row">
          <span class="arming-state arming-state--armed">
            <span class="arming-dot"></span> Key present
          </span>
          <span class="arming-desc">
            Testnet order execution. No additional flag is required.
          </span>
        </div>
      </div>

      <div class="arming-copy">
        <div class="section-head" style="margin-bottom:0">
          <h2>The signer key enables execution.</h2>
          <p>
            Hyperliquid requires signed orders. T3 Trade does not yet include wallet
            onboarding, so you provide one <strong>interim signer key</strong> in
            <code>~/.t3trade/secrets</code>. With the key, T3 Trade can place testnet orders.
            Without it, T3 Trade is read-only. The key does not appear in logs, reports, or
            the database. Expanded key management is not yet available.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Current state ────────────────────────────────────────── -->
  <section id="state" class="sec-state">
    <div class="container">
      <div class="section-head">
        <h2>Current capabilities and limits.</h2>
        <p>T3 Trade is built for supervised, budgeted testnet experiments.</p>
      </div>
      <div class="state-grid">
        <div class="tile state-card">
          <div class="state-card-label state-card-label--is">Today</div>
          <ul>
            <li>Hyperliquid testnet missions with defined scope and loss budgets</li>
            <li>17-check order previews, required stops, and idempotent submission</li>
            <li>Controls that work without the agent running</li>
            <li>Web app and Apple Silicon macOS build; other platforms run from source</li>
          </ul>
        </div>
        <div class="tile state-card">
          <div class="state-card-label state-card-label--isnt">Not today</div>
          <ul>
            <li>No mainnet support</li>
            <li>No strategies, signals, or return guarantees</li>
            <li>No wallet onboarding; you provide one interim signer key</li>
            <li>No unattended use with real funds or mobile app</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Open source ───────────────────────────────────────────── -->
  <section id="open" class="sec-open">
    <div class="container">
      <div class="section-head" style="margin-bottom:0">
        <div class="eyebrow" style="margin-bottom:14px">Open source</div>
        <h2>Open-source and documented.</h2>
        <p>
          T3 Trade is an MIT-licensed fork
          of <a class="inline-link" href={UPSTREAM_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">T3 Code</a> by
          Ping Labs. Trading features are contained in dedicated packages. The rest of the
          code stays close to upstream, and each intentional difference is recorded in a
          patch ledger.
        </p>
        <div class="open-actions">
          <a class="btn btn-primary" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
            Browse the source
          </a>
          <a class="btn btn-ghost" href={`${GITHUB_REPOSITORY_URL}/blob/main/docs/architecture/trading-execution.md`} target="_blank" rel="noopener noreferrer">
            Read the execution design
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ─────────────────────────────────────────────── -->
  <section id="download" class="sec-cta">
    <div class="container cta-inner">
      <h2 class="display cta-title">Run a mission on testnet.</h2>
      <p class="cta-sub">
        Download the alpha, fund a testnet account, define a mission, and review the agent's
        actions.
      </p>
      <div class="cta-actions">
        <a id="cta-download-btn" class="btn btn-primary btn-lg" href="https://github.com/0xgeorgemathew/t3trade/releases">
          Download for macOS
        </a>
        <a class="btn btn-ghost btn-lg" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Run from source</a>
      </div>
      <p class="cta-note">
        The desktop build supports Apple Silicon and is unsigned. Right-click the app and
        choose Open on first launch. Run from source on Windows, Linux, and Intel Macs.
        Older builds and checksums are on the <a href="https://github.com/0xgeorgemathew/t3trade/releases" target="_blank" rel="noopener noreferrer">releases page</a>.
      </p>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL } from "../lib/releases";

  async function initDownload() {
    const heroBtn = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const ctaBtn = document.getElementById("cta-download-btn") as HTMLAnchorElement | null;
    const releaseLine = document.getElementById("hero-release");
    const releaseTag = document.getElementById("hero-release-tag");

    try {
      const release = await fetchLatestRelease();
      const dmg = (release?.assets ?? []).find((a) => a.name.endsWith("-arm64.dmg"));
      if (!dmg) throw new Error("no arm64 dmg in latest release");

      if (heroBtn) heroBtn.href = dmg.browser_download_url;
      if (ctaBtn) ctaBtn.href = dmg.browser_download_url;
      if (releaseLine && releaseTag && release.tag_name) {
        releaseTag.textContent = release.tag_name;
        releaseLine.hidden = false;
      }
    } catch {
      if (heroBtn) heroBtn.href = RELEASES_URL;
      if (ctaBtn) ctaBtn.href = RELEASES_URL;
    }
  }

  function initChecklistReveal() {
    const card = document.querySelector(".preview-card");
    if (!card) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (!("IntersectionObserver" in window)) return;

    card.classList.add("reveal-ready");
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            card.classList.add("is-live");
            observer.disconnect();
          }
        }
      },
      { threshold: 0.35 },
    );
    observer.observe(card);
  }

  initDownload();
  initChecklistReveal();
</script>

<style>
  section {
    position: relative;
    padding: 96px 0;
    border-top: 1px solid var(--border);
  }

  .section-head {
    margin-bottom: 56px;
    max-width: 720px;
  }

  .section-head h2 {
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
    margin-bottom: 18px;
  }

  .section-head p {
    color: var(--fg-muted);
    font-size: 18px;
    max-width: 620px;
    letter-spacing: -0.005em;
  }

  .section-head p strong {
    color: var(--fg);
    font-weight: 500;
  }

  .section-head code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 1px 6px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border);
  }

  .inline-link {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: rgba(250, 250, 250, 0.35);
    text-underline-offset: 3px;
  }

  .inline-link:hover {
    text-decoration-color: var(--fg);
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    padding: 72px 0 60px;
    position: relative;
    overflow: hidden;
    border-top: 0;
  }

  .hero-grid {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 40%, black 40%, transparent 100%);
  }

  .hero-inner {
    position: relative;
    text-align: center;
  }

  /* Staggered hero entrance */
  .hero-eyebrow,
  .hero-title,
  .hero-sub,
  .hero-actions {
    animation: fade-in 0.8s ease-out backwards;
  }

  .hero-title { animation-delay: 0.08s; }
  .hero-sub { animation-delay: 0.16s; }
  .hero-actions { animation-delay: 0.24s; }

  .hero-preview {
    animation: preview-in 1s ease-out 0.34s backwards;
  }

  @keyframes preview-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .hero-eyebrow {
    margin-top: 40px;
    color: var(--accent);
  }

  /* ── Floating harness marks ───────────────────────────────── */
  .hero-float {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  .hero-float-mark {
    --tilt: 0deg;
    position: absolute;
    width: 96px;
    height: 96px;
    border-radius: 24px;
    display: grid;
    place-items: center;
    background: rgba(20, 20, 24, 0.9);
    border: 1px solid var(--border);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow:
      0 20px 48px -16px rgba(0, 0, 0, 0.65),
      0 2px 0 0 rgba(255, 255, 255, 0.04) inset,
      0 0 0 1px color-mix(in srgb, var(--accent) 6%, transparent);
    rotate: var(--tilt);
    animation:
      mark-enter 0.9s ease-out backwards,
      float-drift 9s ease-in-out infinite;
  }

  .hero-float-mark img {
    width: 54px;
    height: 54px;
    display: block;
    object-fit: contain;
  }

  /* Entrance animates opacity/scale only so it can layer over the drift. */
  @keyframes mark-enter {
    from {
      opacity: 0;
      scale: 0.85;
    }
    to {
      opacity: 1;
      scale: 1;
    }
  }

  /* Drift rises and leans a touch further into each mark's own tilt. */
  @keyframes float-drift {
    0%, 100% {
      translate: 0 0;
      rotate: var(--tilt);
    }
    50% {
      translate: 0 -12px;
      rotate: calc(var(--tilt) + 2.5deg);
    }
  }

  .hero-float-mark.hf-claude   { --tilt: -8deg; background: radial-gradient(circle at 30% 25%, rgba(217, 119, 87, 0.22), rgba(20, 20, 24, 0.92) 65%); top: 8%;  left: 7%;  animation-delay: 0.5s, 0s; }
  .hero-float-mark.hf-codex    { --tilt: 6deg;  background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.08), rgba(20, 20, 24, 0.92) 65%); top: 6%;  right: 7%; animation-delay: 0.62s, -2.5s; }
  .hero-float-mark.hf-opencode { --tilt: 4deg;  background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.06), rgba(20, 20, 24, 0.92) 65%); top: 30%; left: 5%;  animation-delay: 0.74s, -5s; }
  .hero-float-mark.hf-cursor   { --tilt: -5deg; background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.08), rgba(20, 20, 24, 0.92) 65%); top: 30%; right: 5%; animation-delay: 0.86s, -7s; }
  .hero-float-mark.hf-grok     { --tilt: 3deg;  background: radial-gradient(circle at 30% 25%, rgba(255, 255, 255, 0.08), rgba(20, 20, 24, 0.92) 65%); top: 52%; left: 6%;  animation-delay: 0.98s, -1.2s; }

  @media (max-width: 1180px) {
    .hero-float-mark { width: 76px; height: 76px; border-radius: 20px; }
    .hero-float-mark img { width: 42px; height: 42px; }
    .hero-float-mark.hf-claude   { top: 4%;  left: 3%; }
    .hero-float-mark.hf-codex    { top: 2%;  right: 3%; }
    .hero-float-mark.hf-opencode { top: 26%; left: 2%; }
    .hero-float-mark.hf-cursor   { top: 24%; right: 2%; }
    .hero-float-mark.hf-grok     { top: 48%; left: 2%; }
  }

  .hero-title {
    font-size: clamp(38px, 5.4vw, 72px);
    margin: 20px auto 22px;
    max-width: 22ch;
    text-wrap: balance;
  }

  .hero-sub {
    color: var(--fg-muted);
    font-size: clamp(16px, 1.4vw, 19px);
    max-width: 680px;
    margin: 0 auto 36px;
    letter-spacing: -0.005em;
    line-height: 1.55;
  }

  .hero-sub strong {
    color: var(--fg);
    font-weight: 500;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-bottom: 56px;
  }

  .dl-icon {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
  }

  .hero-source-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-muted);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.18s ease;
  }

  .hero-source-link:hover {
    color: var(--fg);
  }

  .hero-source-arrow {
    flex-shrink: 0;
    opacity: 0.6;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .hero-source-link:hover .hero-source-arrow {
    transform: translate(2px, -2px);
    opacity: 1;
